# --- Discord bot ---
DISCORD_TOKEN=your-bot-token-here
CHANNEL_ID=your-announcement-channel-id-here
# Optional: role ID to @mention whenever the schedule is posted/updated.
# Leave blank to disable pings entirely.
SCHEDULE_ROLE_ID=

# --- Admin panel ---
ADMIN_PASSWORD=change-me
SESSION_SECRET=any-long-random-string

# --- Behavior ---
TIMEZONE=Asia/Manila
POST_HOUR=1
POST_MINUTE=0
PORT=3000

# Optional: only needed if your host has no persistent disk (e.g. Render's
# free tier). When set, data is stored in MongoDB Atlas's free tier instead
# of local JSON files, so it survives restarts/redeploys. Leave blank if
# you're on a host with a real disk (a VM, Oracle Cloud, your own PC) —
# local files work fine there and this isn't needed.
MONGODB_URI=
