# --- Discord bot ---
DISCORD_TOKEN=your-bot-token-here
CHANNEL_ID=your-announcement-channel-id-here
# Optional: role ID to @mention whenever the schedule is posted/updated.
# Leave blank to disable pings entirely.
SCHEDULE_ROLE_ID=

# --- Admin panel ---
ADMIN_PASSWORD=change-me
SESSION_SECRET=any-long-random-string

# --- Behavior ---
TIMEZONE=Asia/Manila
POST_HOUR=1
POST_MINUTE=0
PORT=3000

# Public base URL where this app is reachable, no trailing slash. Used by
# /calendar to hand out the subscribe link (<PUBLIC_URL>/feed.ics).
# On Render this is picked up automatically from RENDER_EXTERNAL_URL — leave
# blank there. Set it only to override, or on a host that provides no
# equivalent. Without either, /calendar reports the feed isn't configured.
PUBLIC_URL=

# --- Persistent storage: pick ONE, or leave all blank to use local files
# (fine on a host with a real disk — a VM, Oracle Cloud, your own PC) ---

# Option 1 (recommended if you're already using GitHub): store data as JSON
# files in a repo, via the GitHub API. Use a small SEPARATE repo just for
# this — not this bot's own code repo — so saves don't trigger a redeploy
# every time someone edits the schedule.
# Token: github.com/settings/tokens -> generate (classic) -> "repo" scope
GITHUB_TOKEN=
GITHUB_DATA_REPO=yourname/your-data-repo
GITHUB_DATA_BRANCH=main
GITHUB_DATA_DIR=data

# Option 2: MongoDB Atlas free tier. Only used if GITHUB_TOKEN above is
# blank. Needed on hosts (like Render's free tier) with no persistent disk,
# if you're not using the GitHub option instead.
MONGODB_URI=
